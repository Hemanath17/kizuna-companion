DATABASE_URL=
SUPABASE_URL=
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# https://<project-ref>.supabase.co/auth/v1
SUPABASE_ISSUER=
# the Postgres role in the access token's "role" claim; normally "authenticated"
SUPABASE_AUDIENCE=
# Shared with agent-python's .env -- must match exactly on both sides.
INTERNAL_SIGNING_KEY=
INTERNAL_TOKEN_ISSUER=kizuna-dotnet-gateway
INTERNAL_TOKEN_AUDIENCE=kizuna-agent
# Base URL of the Python agent, e.g. http://127.0.0.1:8731
AGENT_PYTHON_URL=
# The Vite dev server origin, for CORS (exact scheme+host+port, no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173
DEEPGRAM_API_KEY=
